# URL base de la API de Artra (NestJS).
#
# Ojo: usa "localhost", no "127.0.0.1", aunque el backend escuche en
# 127.0.0.1:3002. Es el mismo servidor, pero para el navegador
# localhost y 127.0.0.1 son sitios distintos, y la cookie de sesión
# (SameSite=Lax) no viaja entre sitios distintos. Con el front en
# http://localhost:5173 y la API en http://localhost:3002 son el mismo
# site y la cookie fluye sola.
VITE_API_URL="http://localhost:3002"
